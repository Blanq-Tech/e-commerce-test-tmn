# Пул прокси с российскими IP: файл со строками host:port:user:pass.
# Используется в первую очередь, адреса ротируются между воркерами.
PROXIES_FILE=proxies.txt
PROXY_COOLDOWN_SEC=90

# Одиночный прокси-фолбэк, если файла с пулом нет (например, Burp).
# Формат: http://user:pass@host:port  либо  http://host:port
OZON_PROXY=

# Не проверять TLS-сертификат прокси (нужно для перехватывающих прокси вроде Burp).
PROXY_IGNORE_HTTPS=true

# Запуск браузера без окна (true) или с окном (false, удобно для отладки).
HEADLESS=true

# Сколько товаров проверяем максимум (глубина выдачи).
MAX_POSITION=100

# Количество параллельных воркеров (вкладок/контекстов).
CONCURRENCY=3

# Базовые задержки между действиями, мс (антибан).
MIN_DELAY_MS=600
MAX_DELAY_MS=1800

# Сколько раз повторяем задачу при сбое/блокировке.
MAX_RETRIES=3

# Куда складывать результаты.
OUTPUT_DIR=output


